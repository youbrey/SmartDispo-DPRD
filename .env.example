SMARTDISPO_ENV=development
SMARTDISPO_DATABASE_URL=postgresql+asyncpg://smartdispo:smartdispo@postgres:5432/smartdispo
SMARTDISPO_JWT_SECRET=replace-with-at-least-32-random-characters
SMARTDISPO_ACCESS_TOKEN_MINUTES=15
SMARTDISPO_REFRESH_TOKEN_DAYS=7
SMARTDISPO_CORS_ORIGINS=http://localhost:5173
SMARTDISPO_MAX_ATTACHMENT_BYTES=10485760
SMARTDISPO_SIPS_API_KEY=replace-with-a-separate-long-random-service-key
SMARTDISPO_FIREBASE_PROJECT_ID=
SMARTDISPO_FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json
SMARTDISPO_PUSH_POLL_SECONDS=5
SMARTDISPO_REDIS_URL=redis://redis:6379/0
SMARTDISPO_API_RATE_LIMIT_PER_MINUTE=240
SMARTDISPO_LOGIN_RATE_LIMIT_PER_MINUTE=10
SMARTDISPO_BOOTSTRAP_ADMIN_USERNAME=admin
SMARTDISPO_BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
